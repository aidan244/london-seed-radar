# Copy this file to .env and fill in real values. .env is gitignored; never commit it.

# Free key from https://developer.company-information.service.gov.uk/
# Register an application of type "REST API key".
COMPANIES_HOUSE_API_KEY=

# Optional: trigger IDs of the two scheduled cloud scout routines
# (claude.ai/code/routines), shown on the local dashboard's routines
# panel. Account-specific identifiers; keep them out of tracked files.
RADAR_SCOUT_TRIGGER_ID=
RADAR_PREDRAFT_TRIGGER_ID=
